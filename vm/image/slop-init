#!/bin/sh
set -eu

if [ "${1:-}" != overlay-ready ]; then
  mount -t ext4 -o noatime /dev/vdb /mnt/scratch
  mkdir -p /mnt/scratch/upper /mnt/scratch/work
  mount -t overlay overlay \
    -o lowerdir=/,upperdir=/mnt/scratch/upper,workdir=/mnt/scratch/work /mnt/root
  mkdir -p /mnt/root/mnt/old-root
  cd /mnt/root
  pivot_root . mnt/old-root
  exec chroot . /sbin/slop-init overlay-ready
fi

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /run
umount -l /mnt/old-root
rmdir /mnt/old-root

hostname machine
ip link set lo up
printf 'nameserver 127.0.0.1\n' > /etc/resolv.conf

export HOME=/root
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export LANG=C.UTF-8
export HTTPS_PROXY=http://127.0.0.1:3128 https_proxy=http://127.0.0.1:3128
export HTTP_PROXY=http://127.0.0.1:3128 http_proxy=http://127.0.0.1:3128
export NO_PROXY=localhost,127.0.0.1,::1 no_proxy=localhost,127.0.0.1,::1
export NODE_USE_ENV_PROXY=1
egress_ca=/etc/ssl/certs/egress-gateway.pem
export NODE_EXTRA_CA_CERTS=$egress_ca DENO_CERT=$egress_ca
export REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
socat TCP-LISTEN:3128,bind=127.0.0.1,reuseaddr,fork VSOCK-CONNECT:2:1080 &
egress_forwarder=$!
until ss -Hltn 'sport = :3128' | grep -q .; do
  kill -0 "$egress_forwarder"
  sleep 0.01
done
curl -fsS -o "$egress_ca" http://127.0.0.1:3128/egress-ca.pem
cat "$egress_ca" >> /etc/ssl/certs/ca-certificates.crt
mkdir -p /workspace
cd /workspace
exec /usr/bin/tini -- /usr/local/bin/agentd vsock:3000
